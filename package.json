{
  "name": "Tyep",
  "private": true,
  "version": "2.3.0",
  "description": "Tyep point-of-sale desktop application",
  "author": "Tyep",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "desktop": "npm run build && electron .",
    "desktop:win": "npm run build && electron-builder --win dir --x64 && node -e \"const fs=require('node:fs'); const cp=require('node:child_process'); const exe='release/win-unpacked/Tyep.exe'; if (!fs.existsSync(exe)) { console.error('Windows app executable not found in release/win-unpacked/.'); process.exit(1); } console.log('Launching:', exe); cp.spawn(exe,{stdio:'inherit',shell:false});\"",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "firebase": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.2",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.2"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.lassishop.pos",
    "productName": "Tyep",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "build/app-icon.png",
      "electron/*.cjs",
      "node_modules/better-sqlite3/**/*"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tyep",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Tyep Setup ${version}.${ext}"
    }
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.5"
  }
}
